# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection string used by the API server and drizzle-kit
DATABASE_URL=postgresql://user:password@localhost:5432/saas_live_dashboard

# Ports / base path (required by the web app's vite config and the API server)
PORT=5000
BASE_PATH=/

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Logging
LOG_LEVEL=info
